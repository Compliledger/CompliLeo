# CompliLeo backend / Aleo execution configuration
#
# Copy this file to `.env` and adjust as needed. Real keys MUST NOT be
# committed to version control. The MVP defaults are safe for local
# development and CI: they keep the backend in simulated mode.

# ---------------------------------------------------------------------------
# Aleo execution mode
# ---------------------------------------------------------------------------
# Selects how the backend invokes Aleo / Leo logic. One of:
#   simulated  - default. No Leo CLI required; placeholder metadata only.
#   local_cli  - shell out to the locally installed Leo CLI (`leo execute`
#                or `leo run`) for each transition.
# A future `testnet` mode will submit proofs for Aleo network verification.
ALEO_EXECUTION_MODE=simulated

# ---------------------------------------------------------------------------
# Reserved for the upcoming testnet path (NOT used by the MVP)
# ---------------------------------------------------------------------------
# Target Aleo network (e.g. `testnet`, `mainnet`).
ALEO_NETWORK=testnet

# Aleo private key used to sign transitions. Leave blank in this MVP.
# Do NOT commit a real key.
ALEO_PRIVATE_KEY=

# Aleo account address associated with `ALEO_PRIVATE_KEY`. Leave blank.
ALEO_ACCOUNT_ADDRESS=
